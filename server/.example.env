# Supabase (same project — tables + pgvector stay as-is)
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Single LLM provider (OpenAI-compatible). Works with OpenAI, Groq, Together, custom APIs.
# Set the base URL (no trailing /chat/completions) and a key. Then pick models per role.
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=

# Per-role models (all use LLM_API_URL/LLM_API_KEY — swap as needed).
# Default single-doc / general chat: use one fast model for everything.
MODEL_RAG=deepseek-flash
# Multi-doc comparison (only when a conversation has 2+ docs) — defaults to MODEL_RAG if blank.
MODEL_MULTI=deepseek-flash
# Cheap utility: HyDE, router, query rewrite (tiny prompts — defaults to MODEL_RAG if blank).
MODEL_HYDE=deepseek-flash
MODEL_ROUTER=deepseek-flash
MODEL_REWRITE=deepseek-flash
# Summaries / flashcards
MODEL_SUMMARIZER=deepseek-flash

# Thinking level per role (DeepSeek + other reasoning APIs).
# Blank = provider default. Values: disabled, low, medium, high, max.
# THINKING_DEFAULT applies to all roles unless a per-role override is set.
THINKING_DEFAULT=low
THINKING_RAG=low
THINKING_MULTI=low
THINKING_ROUTER=low
THINKING_REWRITE=low
THINKING_HYDE=low
THINKING_SUMMARIZER=low

# This server's public base URL (used to build upload/file URLs)
APP_BASE_URL=http://localhost:8000

# Local file storage root (replaces S3)
STORAGE_DIR=storage
